if [ -n "${VSCODE_GIT_IPC_HANDLE:-}" ]; then
  # Skip husky pre-push when pushing from VSCode to avoid blocking issues
  exit 0
fi

export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "NVM is required to run the pre-push checks." >&2
  exit 1
fi

. "$NVM_DIR/nvm.sh"
nvm use --silent
corepack pnpm run format
