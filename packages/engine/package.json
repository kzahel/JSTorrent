{
  "name": "@jstorrent/engine",
  "version": "1.0.2",
  "description": "BitTorrent client for Node.js - download torrents from the command line",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jstorrent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/daemon/control-connection": {
      "types": "./dist/adapters/daemon/control-connection.d.ts",
      "import": "./dist/adapters/daemon/control-connection.js"
    },
    "./adapters/native": {
      "types": "./dist/adapters/native/index.d.ts",
      "import": "./dist/adapters/native/index.js"
    },
    "./node-io-daemon": {
      "types": "./dist/node-io-daemon/index.d.ts",
      "import": "./dist/node-io-daemon/index.js"
    },
    "./presets/native": {
      "types": "./dist/presets/native.d.ts",
      "import": "./dist/presets/native.js"
    },
    "./presets/node": {
      "types": "./dist/presets/node.d.ts",
      "import": "./dist/presets/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzahel/jstorrent.git",
    "directory": "packages/engine"
  },
  "homepage": "https://jstorrent.com",
  "bugs": {
    "url": "https://github.com/kzahel/jstorrent/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "[ -f src/geo/ipv4-country-data.ts ] || cp src/geo/ipv4-country-data.stub.ts src/geo/ipv4-country-data.ts",
    "build": "tsc && node bundle/build-cli.mjs",
    "build:cli": "node bundle/build-cli.mjs",
    "bundle:native": "node bundle/build-native.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:daemon": "vitest run --config vitest.daemon.config.ts",
    "validate:io-daemon-control-protocol": "node --import tsx scripts/validate-io-daemon-control-protocol.ts",
    "conformance:daemon": "node --import tsx scripts/validate-io-daemon-control-protocol.ts && node --import tsx scripts/run-daemon-conformance.ts",
    "validate:native-bindings-contract": "node --import tsx scripts/validate-native-bindings-contract.ts",
    "validate:native-host-protocol": "node --import tsx scripts/validate-native-host-protocol.ts",
    "conformance:native-host": "node --import tsx scripts/validate-native-host-protocol.ts && node --import tsx scripts/run-native-host-conformance.ts",
    "test:streaming": "vitest run --config vitest.streaming.config.ts",
    "test:python": "cd integration/python && uv run python run_tests.py",
    "test:all": "vitest run && vitest run --config vitest.daemon.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "download-memory": "node --import tsx scripts/download_memory.ts",
    "download-null": "node --import tsx scripts/download_null.ts",
    "bench": "vitest bench",
    "bench:jitless": "NODE_OPTIONS='--jitless' vitest bench"
  },
  "keywords": [
    "bittorrent",
    "torrent",
    "p2p"
  ],
  "author": "JSTorrent Team",
  "license": "MIT",
  "dependencies": {
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.10.0",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.0.0",
    "mediabunny": "^1.38.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "ws": "^8.18.1"
  }
}
