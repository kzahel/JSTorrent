{
  "name": "@jstorrent/client",
  "version": "0.0.1",
  "description": "JSTorrent client adapters and React integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./video-popup": {
      "types": "./dist/components/VideoPopupPage.d.ts",
      "import": "./dist/components/VideoPopupPage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@jstorrent/engine": "workspace:*",
    "@jstorrent/plugin-sdk": "workspace:*",
    "@jstorrent/ui": "workspace:*",
    "playsvideo": "^0.4.7",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.37",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "20.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
